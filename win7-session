#!/bin/sh
# win7-session - Porteus 5.01 - Openbox + win7shell + Wine 8
# Letakkan di /usr/local/bin/win7-session, chmod +x
export WINEARCH=win32
export WINEPREFIX="$HOME/.wine"
export WINEDLLOVERRIDES="mscoree,mshtml="
xset s off
xset -dpms
# Wine server siap duluan biar app Wine langsung muncul
wineserver -p &
# Window manager (tanpa panel sendiri)
openbox &
# Shell Win7 kita - exec biar kalau shell mati, sesi selesai
exec /usr/local/bin/win7shell
